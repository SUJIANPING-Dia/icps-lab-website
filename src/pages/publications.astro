  { year: "2021", type: "int-conference", typeShort: "Conf", typeLabel: "國際研討會論文", title: "iFitness: A Deep Learning-Based Physical Fitness Motion Detection System for Elderly People", authors: "Wan-Jung Chang, et al.", venue: "GCCE 2021", details: "Kyoto, Japan, Oct. 12 – 15, 2021. (EI)" },

