  { year: "2021", type: "int-journal", typeShort: "Journal", typeLabel: "國際期刊論文", title: "An AI Edge Computing-based Assistive System for Visually Impaired Pedestrian Safety", authors: "Wan-Jung Chang, et al.", venue: "IEEE Transactions on Consumer Electronics", details: "Feb. 2021. (SCI)" },

