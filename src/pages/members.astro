---
import Layout from "../layouts/Layout.astro";

// 教授研究專長資料陣列
const expertiseList = [
  { zh: "雲端與智慧物聯網系統", en: "Cloud and AIoT Systems" },
  { zh: "無線感測網路與高速網路系統", en: "Wireless Sensor Networks and High-Speed Networks" },
  { zh: "人工智慧穿戴式裝置聯網系統", en: "Wearable Devices IoT Systems" },
  { zh: "人工智慧醫療聯網系統", en: "Artificial Intelligent Medical IoT (MIoT) Systems" },
  { zh: "人工智慧製造聯網系統", en: "Artificial Intelligent Industrial IoT (IIoT) Systems" },
  { zh: "擴增實境聯網系統", en: "Augmented Reality IoT (ARIoT) Systems" },
  { zh: "人工智慧機器人技術", en: "Artificial Intelligent Robotics" }
];
---

<Layout>
  <main class="mx-auto max-w-7xl px-6 py-24 md:py-32">
    <!-- 麵包屑導航 -->
    <nav class="mb-8 flex text-sm text-slate-400">
      <a href="/" class="transition hover:text-slate-900">首頁</a>
      <span class="mx-2">/</span>
      <span class="font-medium text-slate-900">實驗室成員</span>
    </nav>

    <!-- 頁面標題區 -->
    <header class="mb-20">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 md:text-6xl">
        實驗室成員 <span class="text-emerald-600 font-black italic tracking-tighter">Members</span>
      </h1>
      <p class="mt-6 max-w-3xl text-xl leading-relaxed text-slate-500">
        ICPS Lab 匯聚了對智慧科技充滿熱忱的研究人才。我們的團隊包含指導教授、專任助理、碩士班研究生與大學部專題生，共同推動前瞻技術的發展。
      </p>
    </header>

    <!-- 指導教授 (Principal Investigator) -->
    <section class="mb-24">
      <div class="mb-8 flex items-center gap-4">
        <h2 class="text-2xl font-bold text-slate-900">指導教授</h2>
        <span class="h-px flex-1 bg-slate-200"></span>
      </div>

      <article class="group relative flex flex-col lg:flex-row items-start gap-8 md:gap-12 overflow-hidden rounded-[2.5rem] border border-slate-200 bg-white p-8 md:p-12 transition-all duration-500 hover:border-emerald-300 hover:shadow-2xl hover:shadow-emerald-100/50">
        
        <!-- 照片區塊 (調整為肖像比例 aspect-[4/5]) -->
        <div class="shrink-0 relative flex aspect-[4/5] w-full max-w-[240px] md:max-w-[280px] mx-auto lg:mx-0 items-center justify-center overflow-hidden rounded-[2rem] bg-slate-100 shadow-inner group-hover:shadow-md transition-all border border-slate-200/50">
          
          <!-- 已經為您開啟 img 標籤。請將照片命名為 prof.jpg 並放入 public/images/ 資料夾中 -->
          <!-- 若照片為 png 格式，請記得將下方 src 更改為 /images/prof.png -->
          <img src="/images/prof.jpg" alt="張萬榮 教授" class="absolute inset-0 h-full w-full object-cover z-10 transition-transform duration-500 group-hover:scale-105" onerror="this.style.display='none'" />
          
          <!-- 圖片尚未載入或遺失時的預設背景圖示 -->
          <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 text-slate-300 absolute z-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>

        <!-- 教授資訊區塊 -->
        <div class="flex-1 min-w-0 w-full">
          <!-- 姓名與標題 -->
          <div class="mb-5 text-center lg:text-left">
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full ring-1 ring-emerald-200/50">Principal Investigator</span>
            <h3 class="text-3xl md:text-4xl font-black text-slate-900 mt-4 flex flex-col md:flex-row items-center lg:items-baseline gap-2 lg:gap-4 justify-center lg:justify-start">
              張萬榮
              <span class="text-xl font-bold text-slate-400 font-sans tracking-tight">Wan-Jung Chang</span>
            </h3>
            
            <!-- 所屬組別標籤 -->
            <div class="mt-4 flex flex-wrap justify-center lg:justify-start gap-2">
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600">醫學工程組(合聘)</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600">醫學工程組</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600">AI資安組</span>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600">電信組</span>
            </div>
          </div>
          
          <!-- 聯絡與基本資訊卡片 -->
          <div class="mb-8 rounded-2xl bg-slate-50/80 p-5 md:p-6 ring-1 ring-slate-100">
            <ul class="flex flex-col gap-4 text-sm text-slate-600">
              <li class="flex items-start gap-3">
                <div class="mt-0.5 rounded-lg bg-white p-1.5 shadow-sm text-emerald-500 shrink-0 ring-1 ring-slate-200/50">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" /></svg>
                </div>
                <div><span class="font-bold text-slate-800 mr-2">學歷</span>國立成功大學 電機工程研究所電腦與網路組 博士</div>
              </li>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <li class="flex items-start gap-3">
                  <div class="mt-0.5 rounded-lg bg-white p-1.5 shadow-sm text-emerald-500 shrink-0 ring-1 ring-slate-200/50">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                  </div>
                  <div class="min-w-0"><span class="font-bold text-slate-800 mr-2">信箱</span><a href="mailto:allenchang@nkust.edu.tw" class="text-emerald-600 hover:text-emerald-700 hover:underline break-all transition-colors">allenchang@nkust.edu.tw</a></div>
                </li>
                <li class="flex items-start gap-3">
                  <div class="mt-0.5 rounded-lg bg-white p-1.5 shadow-sm text-emerald-500 shrink-0 ring-1 ring-slate-200/50">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                  </div>
                  <div><span class="font-bold text-slate-800 mr-2">分機</span>15672</div>
                </li>
              </div>
            </ul>
          </div>

          <!-- 研究專長列表 -->
          <div>
            <h4 class="text-sm font-black uppercase tracking-widest text-slate-400 mb-5 flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M11.3 1.046A12.014 12.014 0 0121 11a11.966 11.966 0 01-2.046 6.7c-.287.41-.83.52-1.28.257l-1.92-1.12a.999.999 0 01-.397-1.15A9.957 9.957 0 0019 11a9.956 9.956 0 00-4.687-8.487.999.999 0 01.397-1.15l1.92-1.12c.45-.263.993-.153 1.28.257zM9.692 3.63A8.01 8.01 0 0117 11a7.973 7.973 0 01-1.392 4.542c-.286.405-.828.514-1.272.254l-1.92-1.12a.999.999 0 01-.397-1.15A5.968 5.968 0 0015 11a5.967 5.967 0 00-2.812-5.026.999.999 0 01.397-1.15l1.92-1.12c.444-.26.986-.15 1.272.254z" clip-rule="evenodd" />
                <path d="M5 11a5 5 0 1110 0 5 5 0 01-10 0z" />
              </svg>
              研究專長 / Expertise
            </h4>
            <ul class="grid gap-x-6 gap-y-4 sm:grid-cols-1 md:grid-cols-2">
              {expertiseList.map((item, index) => (
                <li class="flex items-start gap-3 group/item">
                  <div class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-[10px] font-bold text-emerald-600 ring-1 ring-emerald-200/50 group-hover/item:bg-emerald-500 group-hover/item:text-white transition-colors">
                    {index + 1}
                  </div>
                  <div class="min-w-0">
                    <p class="font-bold text-slate-800 text-sm leading-tight group-hover/item:text-emerald-700 transition-colors">{item.zh}</p>
                    <p class="text-[10px] text-slate-400 mt-1 font-mono tracking-tight leading-snug truncate">{item.en}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

        </div>

        <!-- 底部懸浮裝飾線 -->
        <div class="absolute bottom-0 left-0 h-1.5 w-0 bg-emerald-500 transition-all duration-700 group-hover:w-full"></div>
      </article>
    </section>

    <!-- 專任助理 (Lab Assistant) -->
    <section class="mb-24">
      <div class="mb-8 flex items-center gap-4">
        <h2 class="text-2xl font-bold text-slate-900">專任助理</h2>
        <span class="h-px flex-1 bg-slate-200"></span>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <article class="group relative overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-8 transition-all duration-500 hover:-translate-y-1 hover:border-emerald-200 hover:shadow-xl hover:shadow-emerald-50/50">
          <div class="flex items-center gap-6">
            <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl bg-slate-50 border border-slate-100 text-slate-400 group-hover:bg-emerald-50 group-hover:text-emerald-600 transition-colors">
               <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            </div>
            <div>
              <span class="text-[10px] font-black uppercase tracking-[0.2em] text-emerald-600">Lab Assistant</span>
              <h3 class="text-xl font-bold text-slate-900 mt-1">助理姓名</h3>
            </div>
          </div>
          <p class="mt-6 text-sm leading-relaxed text-slate-500">
            負責實驗室行政事務、計畫經費報帳、硬體設備管理與日常研究進度協助。
          </p>
        </article>
      </div>
    </section>

    <!-- 研究生 (Master Students) -->
    <section class="mb-24">
      <div class="mb-8 flex items-center gap-4">
        <h2 class="text-2xl font-bold text-slate-900">碩士班研究生</h2>
        <span class="h-px flex-1 bg-slate-200"></span>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {[1, 2, 3, 4].map((item) => (
          <article class="group relative overflow-hidden rounded-[1.5rem] border border-slate-100 bg-slate-50/50 p-6 transition-all duration-300 hover:bg-white hover:shadow-lg hover:shadow-slate-200/50 hover:border-slate-200">
            <div class="flex items-center gap-4 mb-4">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-white shadow-sm text-slate-300 group-hover:text-emerald-500 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900">研究生姓名</h3>
                <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Master Student</span>
              </div>
            </div>
            <div class="rounded-xl bg-white p-3 border border-slate-100">
              <p class="text-xs font-bold text-slate-400 mb-1">主要研究方向</p>
              <p class="text-sm font-semibold text-slate-700">人工智慧 / 智慧感測</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 專題生 (Undergraduate Students) -->
    <section>
      <div class="mb-8 flex items-center gap-4">
        <h2 class="text-2xl font-bold text-slate-900">大學部專題生</h2>
        <span class="h-px flex-1 bg-slate-200"></span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5">
        {[1, 2, 3, 4, 5].map((item) => (
          <article class="group flex items-center gap-4 rounded-2xl border border-slate-100 bg-white p-4 transition-all hover:border-emerald-200 hover:shadow-md hover:shadow-emerald-50">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-50 text-slate-300 group-hover:bg-emerald-50 group-hover:text-emerald-500 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">專題生姓名</h3>
              <p class="text-[9px] font-bold uppercase tracking-widest text-slate-400">Undergraduate</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>