---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="border-b border-slate-200 bg-slate-50 py-20">
    <div class="mx-auto max-w-5xl px-6">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-400">Members</p>
      <h1 class="mt-4 text-5xl font-bold text-slate-900">實驗室成員</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
        ICPS Lab 成員包含指導教授、助理、研究生與專題生，持續推動實驗室研究與發展。
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-slate-900">指導教授</h2>

      <div class="mt-8 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
        <div class="grid gap-8 md:grid-cols-[220px_1fr]">
          <div class="flex h-56 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
            教授照片之後放這裡
          </div>

          <div>
            <h3 class="text-3xl font-bold text-slate-900">張萬榮 教授</h3>
            <p class="mt-2 text-slate-500">Professor / Principal Investigator</p>
            <p class="mt-5 leading-8 text-slate-600">
              研究領域涵蓋智慧網宇實體系統、人工智慧、物聯網、延展實境、
              智慧感測、智慧醫療與跨域整合應用。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-slate-900">助理</h2>

      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <h3 class="text-xl font-semibold text-slate-900">助理姓名</h3>
          <p class="mt-2 text-slate-500">Lab Assistant</p>
          <p class="mt-4 text-slate-600">負責實驗室行政、設備管理與研究協助。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-slate-900">研究生</h2>

      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl bg-slate-50 p-6 shadow-sm ring-1 ring-slate-200">
          <h3 class="text-xl font-semibold text-slate-900">研究生姓名</h3>
          <p class="mt-2 text-slate-500">Master Student</p>
          <p class="mt-4 text-slate-600">研究方向：人工智慧 / 智慧感測</p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-6 shadow-sm ring-1 ring-slate-200">
          <h3 class="text-xl font-semibold text-slate-900">研究生姓名</h3>
          <p class="mt-2 text-slate-500">Master Student</p>
          <p class="mt-4 text-slate-600">研究方向：物聯網 / 智慧系統</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-slate-900">專題生</h2>

      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <h3 class="text-lg font-semibold text-slate-900">專題生姓名</h3>
          <p class="mt-2 text-slate-500">Undergraduate Project Student</p>
        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <h3 class="text-lg font-semibold text-slate-900">專題生姓名</h3>
          <p class="mt-2 text-slate-500">Undergraduate Project Student</p>
        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <h3 class="text-lg font-semibold text-slate-900">專題生姓名</h3>
          <p class="mt-2 text-slate-500">Undergraduate Project Student</p>
        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <h3 class="text-lg font-semibold text-slate-900">專題生姓名</h3>
          <p class="mt-2 text-slate-500">Undergraduate Project Student</p>
        </div>
      </div>
    </div>
  </section>
</Layout>