---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <!-- 1. Hero Section -->
    <section class="relative overflow-hidden bg-white pb-20 pt-32 md:pt-40">
      <div class="absolute -left-20 top-0 h-[500px] w-[500px] rounded-full bg-sky-50/50 blur-3xl"></div>
      <div class="absolute -right-20 top-20 h-[500px] w-[500px] rounded-full bg-indigo-50/50 blur-3xl"></div>

      <div class="relative mx-auto max-w-7xl px-6">
        <div class="grid items-center gap-16 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <div class="mb-6 flex items-center gap-2">
              <span class="h-px w-8 bg-slate-300"></span>
              <p class="text-sm font-semibold tracking-widest text-slate-500 uppercase">
                NKUST · Jiangong Campus
              </p>
            </div>

            <h1 class="text-5xl font-extrabold tracking-tight text-slate-900 md:text-7xl">
              智慧網宇實體系統<br />
              <span class="bg-gradient-to-r from-sky-600 to-indigo-600 bg-clip-text text-transparent">
                實驗室 ICPS Lab
              </span>
            </h1>

            <p class="mt-8 max-w-2xl text-lg leading-relaxed text-slate-600">
              我們致力於 <span class="font-semibold text-slate-900">AI × IoT × XR</span> 的前瞻研究，
              透過精準感測與智慧分析，打破虛擬與現實的邊界，開創智慧系統的新篇章。
            </p>

            <div class="mt-10 flex flex-wrap gap-4">
              <a href="/research" class="group flex items-center gap-2 rounded-full bg-slate-900 px-8 py-4 text-sm font-bold text-white transition-all hover:bg-slate-800 hover:shadow-lg active:scale-95">
                探索研究領域
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a href="/members" class="rounded-full border border-slate-200 bg-white px-8 py-4 text-sm font-bold text-slate-700 transition-all hover:border-slate-400 hover:bg-slate-50 active:scale-95">
                團隊成員
              </a>
            </div>
          </div>

          <div class="relative lg:col-span-5">
            <div class="relative z-10 overflow-hidden rounded-[2.5rem] border border-slate-200 bg-white p-2 shadow-2xl">
              <div class="flex aspect-[4/5] items-center justify-center rounded-[2rem] bg-slate-50 text-slate-400">
                <span class="text-center p-8">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto mb-4 h-12 w-12 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  實驗室照片暫存區
                </span>
              </div>
            </div>
            <div class="absolute -bottom-6 -left-10 z-20 hidden rounded-2xl bg-white/80 p-6 shadow-xl backdrop-blur-md border border-white md:block">
              <div class="flex items-center gap-4">
                <div class="flex -space-x-2">
                  {[1,2,3].map(() => (
                    <div class="h-8 w-8 rounded-full border-2 border-white bg-slate-200"></div>
                  ))}
                </div>
                <p class="text-xs font-medium text-slate-600">20+ 成員在線研究</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Stats: 數據區塊 (已更新名稱) -->
    <section class="border-y border-slate-100 bg-slate-50/50 py-12">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid grid-cols-2 gap-4 md:gap-8 md:grid-cols-4">
          {[
            { label: "重要著作", val: "50+", href: "/publications" },
            { label: "研究計畫", val: "12+", href: "/projects" },
            { label: "獲獎紀錄", val: "5+", href: "/awards" },
            { label: "合作夥伴", val: "8+", href: "/partners" },
          ].map((stat) => (
            <a 
              href={stat.href} 
              class="group block rounded-2xl p-6 text-center transition-all hover:bg-white hover:shadow-md hover:-translate-y-1 active:scale-95"
            >
              <p class="text-3xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors">{stat.val}</p>
              <p class="text-sm text-slate-500 mt-1 font-medium">{stat.label}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. About -->
    <section class="py-24">
      <div class="mx-auto max-w-4xl px-6">
        <div class="text-center">
          <span class="inline-block rounded-full bg-sky-50 px-4 py-1.5 text-xs font-bold tracking-widest text-sky-700 uppercase mb-4">
            Mission
          </span>
          <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">
            跨越物理與數位，構建更智慧的世界
          </h2>
          <p class="mt-8 text-lg leading-relaxed text-slate-600">
            智慧網宇實體系統實驗室（ICPS Lab）致力於推動前瞻性實務與學術研究。
            我們不只關注技術本身，更在乎技術如何真正應用於生活，解決醫療、製造與交通中的複雜挑戰。
          </p>
        </div>
      </div>
    </section>

    <!-- 4. Core Tech -->
    <section class="bg-slate-50 py-24">
      <div class="mx-auto max-w-7xl px-6">
        <div class="mb-16 flex flex-col items-center justify-between gap-4 md:flex-row md:items-end">
          <div>
            <h2 class="text-3xl font-bold text-slate-900">核心研究技術</h2>
            <p class="mt-2 text-slate-500 text-lg">透過三位一體的技術結構，建構全方位智慧系統。</p>
          </div>
          <a href="/research" class="text-sm font-bold text-sky-600 hover:text-sky-700">探索所有技術 →</a>
        </div>

        <div class="grid gap-8 md:grid-cols-3">
          {[
            { title: "AI", name: "人工智慧", desc: "運用深度學習進行精準影像辨識與智慧預測。", icon: "brain", color: "bg-slate-900" },
            { title: "IoT", name: "物聯網", desc: "設計低功耗感測網路，實現全時段環境數據監控。", icon: "wifi", color: "bg-sky-600" },
            { title: "XR", name: "延展實境", desc: "開發沉浸式互動系統，將數據視覺化呈現於實體空間。", icon: "box", color: "bg-indigo-600" },
          ].map((tech) => (
            <div class="group relative rounded-[2rem] bg-white p-8 shadow-sm transition-all hover:-translate-y-2 hover:shadow-xl ring-1 ring-slate-100">
              <div class={`mb-6 flex h-14 w-14 items-center justify-center rounded-2xl text-white shadow-lg ${tech.color}`}>
                <span class="text-xl font-bold">{tech.title}</span>
              </div>
              <h3 class="text-2xl font-bold text-slate-900">{tech.name}</h3>
              <p class="mt-4 leading-relaxed text-slate-500">{tech.desc}</p>
              <div class="mt-8 h-1 w-0 bg-slate-200 transition-all group-hover:w-full"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Latest News -->
    <section class="py-24 bg-white">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="text-3xl font-bold text-slate-900 mb-12">最新動態</h2>
        <div class="divide-y divide-slate-100">
          {[
            { date: "2026.03.20", cat: "公告", title: "ICPS Lab 官方網站正式對外發布！", link: "#" },
            { date: "2026.03.15", cat: "招募", title: "歡迎大二、大三專題生加入研究團隊", link: "#" },
            { date: "2026.03.05", cat: "研究", title: "本實驗室獲得 114 年度國科會研究計畫補助", link: "#" },
          ].map((news) => (
            <a href={news.link} class="group flex flex-col items-start gap-4 py-8 md:flex-row md:items-center">
              <div class="flex min-w-[140px] items-center gap-3">
                <span class="text-sm font-medium text-slate-400 font-mono">{news.date}</span>
                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-500 uppercase">{news.cat}</span>
              </div>
              <h3 class="flex-1 text-xl font-semibold text-slate-700 transition-colors group-hover:text-sky-600">
                {news.title}
              </h3>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 -rotate-45 text-slate-300 transition-all group-hover:rotate-0 group-hover:text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          ))}
        </div>
        <div class="mt-12 text-center">
            <a href="/news" class="text-sm font-bold text-slate-400 hover:text-slate-600 transition-colors">
                瀏覽所有消息記錄
            </a>
        </div>
      </div>
    </section>
  </main>
</Layout>